# InsightEngine Environment Configuration
APP_NAME=InsightEngine
APP_ENV=development
API_V1_PREFIX=/api/v1
PORT=8000
HOST=127.0.0.1

# MySQL Database Configuration
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/insightengine

# File Upload Limits
MAX_UPLOAD_SIZE_MB=5
MAX_CSV_ROWS=5000
